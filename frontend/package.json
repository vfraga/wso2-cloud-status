{
  "name": "wso2-cloud-status-frontend",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11"
  },
  "dependencies": {
    "@wso2/oxygen-ui": "0.16.0",
    "@wso2/oxygen-ui-icons-react": "0.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage && npm run test:zones",
    "test:zones": "VITEST_TZ=Asia/Colombo vitest run && VITEST_TZ=America/Sao_Paulo vitest run && VITEST_LOCALE=de LC_ALL=de_DE.UTF-8 LANG=de_DE.UTF-8 vitest run src/lib/locale.test.ts",
    "test:watch": "vitest",
    "e2e:install": "playwright install chromium",
    "e2e": "bash scripts/e2e.sh"
  }
}

{
  "description": "Accept-Encoding header -> whether the response is gzip. One table for the Go unit tests and the contract tests. Grammar: RFC 9110 section 12.5.3; q is 0[.ddd] or 1[.000], the q is case-insensitive, whitespace is allowed around entries and around ';'. An explicit gzip entry decides before '*'. Malformed entries are ignored.",
  "cases": [
    { "header": "", "gzip": false },
    { "header": "gzip", "gzip": true },
    { "header": "GZIP", "gzip": true },
    { "header": " gzip ", "gzip": true },
    { "header": "br, gzip", "gzip": true },
    { "header": "br, gzip;q=0.8", "gzip": true },
    { "header": "deflate", "gzip": false },
    { "header": "identity", "gzip": false },
    { "header": "gzip;q=0", "gzip": false },
    { "header": "gzip;q=0.", "gzip": false },
    { "header": "gzip;q=0.000", "gzip": false },
    { "header": "gzip;q=0.001", "gzip": true },
    { "header": "gzip;q=1", "gzip": true },
    { "header": "gzip;q=1.", "gzip": true },
    { "header": "gzip;q=1.000", "gzip": true },
    { "header": "gzip;Q=0.5", "gzip": true },
    { "header": "gzip ; q=0.5", "gzip": true },
    { "header": "gzip; q=0", "gzip": false },
    { "header": "gzip;q=1.001", "gzip": false },
    { "header": "gzip;q=1.5", "gzip": false },
    { "header": "gzip;q=2", "gzip": false },
    { "header": "gzip;q=0.0001", "gzip": false },
    { "header": "gzip;q=.5", "gzip": false },
    { "header": "gzip;q=-1", "gzip": false },
    { "header": "gzip;q=", "gzip": false },
    { "header": "gzip;q=abc", "gzip": false },
    { "header": "gzip;q=1e-1", "gzip": false },
    { "header": "gzip;q = 0.5", "gzip": false },
    { "header": "gzip;q=0.5;level=1", "gzip": false },
    { "header": "gzip;level=1", "gzip": false },
    { "header": "*", "gzip": true },
    { "header": "*;q=0", "gzip": false },
    { "header": "*;q=0.5", "gzip": true },
    { "header": "gzip;q=abc, *;q=0.5", "gzip": true },
    { "header": "*;q=0, gzip", "gzip": true },
    { "header": "gzip;q=0, *", "gzip": false },
    { "header": "*, gzip;q=0", "gzip": false },
    { "header": "br;q=1, gzip;q=0.5, *;q=0", "gzip": true },
    { "header": ", ,gzip", "gzip": true },
    { "header": "br;q=1, identity;q=0.5", "gzip": false }
  ]
}
